# Copy this file to .env and update the values below
# (never commit .env - on Render, set these as Environment Variables instead)

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration (Aiven MySQL: copy values from the service overview page)
DB_DRIVER=mysql
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=

# Aiven requires TLS. Pick ONE:
#   Local:  path to the downloaded ca.pem
#   DB_SSL_CA=C:/path/to/ca.pem
#   Render: base64 of ca.pem   (Linux/macOS: base64 -w0 ca.pem | PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca.pem")))
#   DB_SSL_CA_BASE64=
#   Fallback (encrypt, no certificate check):
#   DB_SSL=true

# For API (run: php lava jwt:generate  to fill these in automatically)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# CORS: comma-separated frontend origins (use * only for quick local tests)
FRONTEND_ORIGIN=http://localhost:5173

# Allow migration routes over HTTP (development ONLY, never on Render)
MIGRATION_WEB=false
